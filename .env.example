# ============================================================================
#  «Мясо для собак» — пример файла окружения.
#
#  Скопируйте его в .env и заполните значения:
#      Linux/macOS :  cp .env.example .env
#      PowerShell  :  Copy-Item .env.example .env
#
#  .env в git НЕ попадает (см. .gitignore). Секреты здесь оставлены ПУСТЫМИ.
#  Backend читает .env из корня проекта и из каталога backend/ (app/core/config.py).
# ============================================================================


# ---------------------------------------------------------------------------
#  1. Telegram
# ---------------------------------------------------------------------------

# ОБЯЗАТЕЛЬНО. Токен бота от @BotFather: 1234567890:AAH...
# Им же проверяется подпись initData — без него вход в Mini App работать не будет.
BOT_TOKEN=

# ОБЯЗАТЕЛЬНО. Имя бота без @ — используется в ссылках вида t.me/<username>.
BOT_USERNAME=

# polling | webhook. Для локальной разработки — polling.
# webhook требует публичного HTTPS-адреса (PUBLIC_BASE_URL) и обычно нужен только в production.
BOT_MODE=polling

# ОБЯЗАТЕЛЬНО для работы внутри Telegram. Публичный HTTPS-адрес фронтенда,
# он же указывается в BotFather (/newapp или /setmenubutton).
# Локально без туннеля Telegram Mini App не откроется: нужен https, не localhost.
# Пример с туннелем: https://random-words-1234.trycloudflare.com
WEBAPP_URL=http://localhost:5173

# Публичный адрес backend. Используется для абсолютных ссылок на фотографии
# и для установки webhook, когда BOT_MODE=webhook.
PUBLIC_BASE_URL=http://localhost:8000


# ---------------------------------------------------------------------------
#  2. База данных
# ---------------------------------------------------------------------------

# Значение НИЖЕ рассчитано на ЛОКАЛЬНЫЙ запуск (без Docker): хост localhost,
# порт 5433 — именно его наружу отдаёт сервис db из docker-compose.yml.
#
#   локально, БД поднята через docker compose : ...@localhost:5433/meat
#   локально, свой PostgreSQL на 5432         : ...@localhost:5432/meat
#   ВНУТРИ docker compose                     : ...@db:5432/meat
#
# Для контейнеров эту переменную подставлять НЕ нужно: docker-compose.yml
# перекрывает DATABASE_URL значением с хостом `db` (секция environment у backend/bot).
# Драйвер обязателен: postgresql+asyncpg (SQLAlchemy async).
DATABASE_URL=postgresql+asyncpg://meat:meat@localhost:5433/meat

# Учётные данные контейнера postgres. Должны совпадать с DATABASE_URL выше.
POSTGRES_USER=meat
POSTGRES_PASSWORD=meat
POSTGRES_DB=meat


# ---------------------------------------------------------------------------
#  3. Доступ и безопасность
# ---------------------------------------------------------------------------

# ОБЯЗАТЕЛЬНО, иначе админка будет недоступна никому.
# Telegram ID администраторов через запятую. Свой ID можно узнать у @userinfobot.
# Пример: 123456789,987654321
ADMIN_TELEGRAM_IDS=

# Максимальный возраст auth_date в initData (секунды). Сутки по умолчанию.
INIT_DATA_TTL_SECONDS=86400

# Вход без Telegram — только для разработки фронтенда в обычном браузере.
# Работает лишь если DEV_AUTH_ENABLED=true И ENVIRONMENT != production.
# В production ОБЯЗАТЕЛЬНО false.
DEV_AUTH_ENABLED=false

# Под каким Telegram ID работать в dev-режиме. Укажите свой, чтобы видеть админку.
DEV_TELEGRAM_ID=0

# Домены, которым разрешён CORS, через запятую.
# Сюда добавляется адрес фронтенда, включая адрес HTTPS-туннеля.
# Пример: http://localhost:5173,https://random-words-1234.trycloudflare.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ---------------------------------------------------------------------------
#  4. Магазин
# ---------------------------------------------------------------------------

# Стоимость доставки в рублях. Для самовывоза не добавляется.
# Десятичное число, точка как разделитель.
DELIVERY_PRICE=300.00

# Адрес самовывоза — показывается покупателю при оформлении.
PICKUP_ADDRESS=г. Москва, ул. Примерная, 1


# ---------------------------------------------------------------------------
#  5. Загрузка файлов
# ---------------------------------------------------------------------------

# Каталог для фотографий товаров.
# Относительный путь разрешается от корня проекта -> ./uploads.
# В docker-compose.yml перекрывается на абсолютный /app/uploads (том `uploads`).
UPLOAD_DIR=uploads

# Максимальный размер загружаемого файла, МБ. nginx пропускает до 10 МБ,
# так что превышение вернёт понятную ошибку API file_too_large, а не 413 от nginx.
MAX_UPLOAD_SIZE_MB=5


# ---------------------------------------------------------------------------
#  6. Окружение и логи
# ---------------------------------------------------------------------------

# development | production. В production выключается dev-авторизация.
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
#  7. Ограничение частоты запросов (формат «запросов/секунд»)
# ---------------------------------------------------------------------------

# Аутентификация: 30 запросов за 60 секунд.
RATE_LIMIT_AUTH=30/60

# Создание заказов: 10 запросов за 60 секунд.
RATE_LIMIT_ORDERS=10/60

# Загрузка фотографий: 20 запросов за 60 секунд.
RATE_LIMIT_UPLOADS=20/60


# ---------------------------------------------------------------------------
#  8. Webhook (нужно только при BOT_MODE=webhook)
# ---------------------------------------------------------------------------

# Путь, по которому backend принимает апдейты Telegram.
WEBHOOK_PATH=/telegram/webhook

# Произвольная строка-секрет: Telegram присылает её в заголовке
# X-Telegram-Bot-Api-Secret-Token, backend сверяет и отбрасывает чужие запросы.
WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
#  9. Порты и сборка (читает только docker-compose.yml)
# ---------------------------------------------------------------------------

# Порт PostgreSQL на хосте. 5433, чтобы не конфликтовать с локальной СУБД.
DB_PORT=5433

# Порт backend на хосте.
BACKEND_PORT=8000

# Порт frontend (nginx) на хосте.
FRONTEND_PORT=5173

# Базовый путь API для сборки фронтенда. Относительный — запросы идут на тот же
# origin, а nginx проксирует их на backend.
VITE_API_BASE_URL=/api/v1

# Часовой пояс контейнеров.
TZ=Europe/Moscow
