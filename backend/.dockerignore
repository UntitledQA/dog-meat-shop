# Что НЕ попадает в контекст сборки backend-образа.

# --- виртуальные окружения и артефакты Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# --- кэши инструментов ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# --- секреты и локальные данные ---
.env
.env.*
!.env.example
*.db
*.sqlite
*.sqlite3
uploads/
logs/
*.log

# --- git и служебное ---
.git/
.gitignore
.gitattributes
.dockerignore
Dockerfile
docker-compose*.yml

# --- IDE / ОС ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- тесты и документация в образе не нужны ---
tests/
docs/
*.md
!README.md
